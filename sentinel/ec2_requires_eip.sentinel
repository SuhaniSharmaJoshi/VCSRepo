import "tfplan/v2" as tfplan

ec2_instances = filter tfplan.resource_changes as _, rc {
  rc.type == "aws_instance" and
  rc.change.actions contains any ["create", "update", "no-op"]
}

elastic_ips = filter tfplan.resource_changes as _, rc {
  rc.type == "aws_eip" and
  rc.change.actions contains any ["create", "update", "no-op"]
}

main = rule {
  length(ec2_instances) == 0 or length(elastic_ips) >= 1
}
